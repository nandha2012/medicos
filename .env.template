# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Environment
# Set to 'local' to automatically use SmartRequest faker for testing
ENV=local

# External API Configuration (RedCap)
EXTERNAL_API_END_POINT=https://localhost/redcap/api/
EXTERNAL_API_TOKEN=your_redcap_token_here

# NAS REDCap API Configuration (separate project from the main medicos REDCap)
NAS_API_END_POINT=https://localhost/redcap/api/
NAS_API_TOKEN=your_nas_redcap_token_here
NAS_TIME_DELTA=1
NAS_TIME_DELTA_PERIOD=months

# SmartRequest (Datavant) API Configuration
# For sandbox environment, use: https://sandbox-api.datavant.com/v1
# For production environment, use: https://requester-api.datavant.com/v1
SMARTREQUEST_BASE_URL=https://sandbox-api.datavant.com/v1
SMARTREQUEST_CLIENT_ID=your_client_id_here
SMARTREQUEST_CLIENT_SECRET=your_client_secret_here

# SmartRequest Faker Configuration
# Set to 'true' to force using faker even with valid credentials
USE_SMARTREQUEST_FAKER=false

# Optional: Time delta configuration for API calls
# How far back to look for records (used with time_delta_period)
time_delta=1

# Time period unit for looking back (hours, days, etc.)
time_delta_period=hours

# Note: SmartRequest API credentials are environment-specific:
# - Sandbox credentials work only in sandbox environment
# - Production credentials work only in production environment
# 
# Credentials are provided as password-protected bitwarden links by Datavant
# for pilot customers.
